{
  "name": "@deepseek-ai/dsh-conductor-bundle",
  "description": "Installable profile bundle for DeepSeek Harness conductor-mode orchestration",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/conductor"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./tool-conductor": {
      "types": "./lib/types/tool-conductor.d.ts",
      "default": "./lib/types/tool-conductor.js"
    },
    "./tool-task-report": {
      "types": "./lib/types/tool-task-report.d.ts",
      "default": "./lib/types/tool-task-report.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "agent-presets/conductor/agent.cordis.yml",
    "agent-presets/conductor/preset.yml",
    "cordis.patch.yml",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-conductor": "workspace:^",
    "@deepseek-ai/dsh-conductor-round-driver": "workspace:^",
    "@deepseek-ai/dsh-tool-conductor": "workspace:^",
    "@deepseek-ai/dsh-tool-task-report": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
